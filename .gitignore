# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/

# ── PyInstaller build output (the released .exe is attached to Releases) ────
build/
dist/
release/*.exe
release/*.zip
release/Font.ttf
release/T14LOAD.bin
release/pfsshell.exe
release/vgmstream-win64/
build_log*.txt
dist2/

# ── Local settings (machine-specific paths) ────────────────────────────────
config.ini
# Developer sample files for the module self-tests (apppaths.samples_dir())
samples/

# ── Bundled runtime deps you must supply yourself (NOT redistributed) ───────
